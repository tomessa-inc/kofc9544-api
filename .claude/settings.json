{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-unit-tests.sh",
            "timeout": 120,
            "statusMessage": "Running unit tests..."
          }
        ]
      }
    ]
  }
}
